# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Apps Script Web App Bridge (enables automatic sign-in-free Drive/Sheets sync)
# Deploy the Apps Script from Settings -> Automatic Drive Folder Bridge, then set these values:
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycbyTj9mCkKeQa3s4ZPWFlxBSweV1vDMes0sXcXlDF77NS7vfV1Airk8qzrdbEqGidNGCMQ/exec"
GOOGLE_APPS_SCRIPT_SECRET="AKfycbyTj9mCkKeQa3s4ZPWFlxBSweV1vDMes0sXcXlDF77NS7vfV1Airk8qzrdbEqGidNGCMQ"
GOOGLE_DRIVE_TARGET_FOLDER_ID="1OjfZm2kE5F9yGnmdFIv8WZpuAPpu9VpG"
